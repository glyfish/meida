.DS_Store
__pycache__/
.pytest_cache/
*.pyc
logs/*
!logs/.gitkeep
.ropeproject
*.log
*.aux
*.out
*.gz
*.fdb_latexmk
*.fls
*.pyg
*.bak
.ipynb_checkpoints
_minted*
.env
.keys

# FRED data (downloaded locally, not tracked)
notebooks/fred/series/series_data/
notebooks/fred/categories/category_data/

# BLS data (downloaded locally, not tracked)
notebooks/bls/notebook_downloads/
# Exported BLS metadata catalogs (regenerable; consumed by the yada project)
notebooks/bls/data/

# Exported BIS metadata catalogs (regenerable; consumed by the yada project)
notebooks/bis/data/

# Exported CDC series catalog (regenerable; consumed by the yada project)
notebooks/voteview/data/
notebooks/cdc/data/
# ...except the normalized WONDER/NVSR series, which are tracked on purpose.
# Both sources are rebuildable now (notebooks/cdc/downloads.ipynb), so this is
# not about losing them -- it is that NCHS revises published data in place.
# Re-running the pipeline today already moves eight of drug-induced's
# twenty-two years by a death or two. Tracked, an upstream revision arrives as
# a reviewable diff; untracked, the numbers just quietly change.
!notebooks/cdc/data/timeseries/
!notebooks/cdc/data/timeseries/*.jsonl

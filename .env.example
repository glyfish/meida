# meida configuration. Copy to .env and fill in. Loaded by environment.py,
# which anchors on this directory rather than the working directory, so a
# terminal run and a VS Code run (python.envFile) resolve identically.
# Anything already exported in the shell wins over this file.

# --- required -----------------------------------------------------------
FRED_API_KEY=
TIINGO_API_KEY=

# --- optional -----------------------------------------------------------
# BLS works without a key at reduced limits; a key also enables the
# catalog and calculations fields.
BLS_API_KEY=
# A Socrata app token, not a secret -- it only raises CDC rate limits.
CDC_API_KEY=

# --- overrides ----------------------------------------------------------
# All have working defaults in environment.py; set only to point elsewhere.
#FRED_BASE_URL=https://api.stlouisfed.org/fred
#BLS_BASE_URL=https://api.bls.gov/publicAPI/v2
#BIS_BASE_URL=https://stats.bis.org/api/v1
#TIINGO_BASE_URL=https://api.tiingo.com/tiingo
#CDC_BASE_URL=https://data.cdc.gov
#MCP_URL=http://localhost:8080/sse
#MEIDA_DB_URL=postgresql+psycopg://meida@localhost/meida

# Used by the VS Code launch configs, not by environment.py.
PYTHONPATH=${HOME}/Develop/gly.fish/meida:${HOME}/Develop/gly.fish/navi:${PYTHONPATH}
MCP_SERVER_TRANSPORT=sse
